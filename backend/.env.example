APP_NAME=UniMate AI
ENVIRONMENT=development

# Porta 5433 sepse docker-compose e mapon ashtu.
DATABASE_URL=postgresql+psycopg://unimate:UniMateDB2026!@localhost:5433/unimate_db

# Gjenero një çelës të ri: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ndrysho-kete-vlere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Merre nga https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=8000
LLM_EFFORT=medium
AGENT_MAX_ITERATIONS=6

RAG_TOP_K=5
RAG_MIN_SCORE=0.25
