# Konfigurimi i `docker compose`. Kopjoje si `.env` në rrënjë:
#
#     cp .env.example .env
#
# I vetmi çelës i domosdoshëm është ANTHROPIC_API_KEY. Pa të, gjithçka
# tjetër punon (kyçja, paneli, dokumentet, guardrail-i), por chat-i
# kthen 503 sepse modeli nuk mund të thirret.

# Merre nga https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gjenero një çelës të ri:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ndrysho-kete-vlere-para-prodhimit

LLM_MODEL=claude-sonnet-5

# 1 = mbush të dhënat demo në çdo nisje (idempotente), 0 = jo.
SEED_ON_STARTUP=1
